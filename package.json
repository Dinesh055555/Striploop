{
  "name": "striploop-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "StripLoop: Destroy. Recover. Prove. Chain of custody, recovery and green lending prototype for Sankalp by Satin Finserv.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node server/selftest.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
